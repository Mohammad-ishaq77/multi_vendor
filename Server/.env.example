PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL 16 + PostGIS) ---
DATABASE_URL=postgres://nearmart:nearmart@localhost:5432/nearmart
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# --- Auth ---
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Razorpay dashboard keys — never commit real values ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudinary (file uploads) — leave blank to use local stub URLs ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
