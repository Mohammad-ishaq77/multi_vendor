# Public Razorpay key (safe to expose in the frontend)
VITE_RAZORPAY_KEY_ID=

# Payment API base URL. Use /api with the Vite proxy in local development.
VITE_API_BASE_URL=/api

# MapTiler public key (safe to expose: restrict it to your domains at
# https://cloud.maptiler.com/account/keys/). Powers the map, place search and
# reverse geocoding in the location picker. Without it the picker shows a
# "MapTiler key not configured" notice.
VITE_MAPTILER_API_KEY=
