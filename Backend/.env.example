# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──
NODE_ENV=development
PORT=5000
# Comma-separated origins are supported for CORS (e.g. local + production).
CLIENT_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL + PostGIS) ──
DATABASE_URL=postgresql://user:password@localhost:5432/nearmart
TYPEORM_SYNC=false
TYPEORM_LOGGING=false

# ── Auth ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ── Demo mode ──
# When true, OTPs are fixed to 1234 and OTP emails are skipped. Opt-in only:
# leave false for a real production deployment; set true for a demo deployment.
DEMO_OTP_ENABLED=false

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI chatbot ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_API_KEY=

# ── Email (contact form + transactional OTPs) ──
# Provider: "smtp" (Gmail/SMTP) or "resend". Leave blank to auto-detect.
EMAIL_PROVIDER=smtp

# Address shown in the From header. For Resend this must be on a verified domain.
SENDER_EMAIL=nearmart.business@gmail.com
SENDER_NAME=NearMart

# Inbox that receives contact-form messages (defaults to SENDER_EMAIL).
RECEIVER_EMAIL=nearmart.business@gmail.com

# --- Option A: Gmail SMTP with an App Password (matches this project) ---
# Enable 2-Step Verification, then create an App Password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=nearmart.business@gmail.com
SMTP_PASS=your-16-character-app-password

# Legacy Gmail variable names still work if SMTP_* is omitted:
# MAIL_USER=nearmart.business@gmail.com
# MAIL_PASS=your-16-character-app-password
# MAIL_CONTACT_TO=nearmart.business@gmail.com

# --- Option B: Resend (HTTP API; no SMTP required) ---
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# SENDER_EMAIL=contact@your-verified-domain.com
# RECEIVER_EMAIL=you@your-domain.com
